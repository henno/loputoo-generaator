<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <info>
    <title>VIKK lõputöö viidete stiil</title>
    <id>http://www.zotero.org/styles/vikk-thesis</id>
    <link href="http://www.zotero.org/styles/vikk-thesis" rel="self"/>
    <author>
      <name>Custom</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <updated>2025-01-01T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="et">
    <terms>
      <term name="page" form="short">lk</term>
      <term name="number" form="short">nr</term>
      <term name="edition">väljaanne</term>
    </terms>
  </locale>

  <!-- Autorite kuvamine kirjandusloendis -->
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" and="symbol" sort-separator=", " initialize-with=". " delimiter=", " delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- Autorid tekstiviites -->
  <macro name="author-intext">
    <names variable="author">
      <name form="short" and="symbol" delimiter=", " initialize-with=". "/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- Aasta -->
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued" date-parts="year" form="numeric"/>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <!-- Lehekülje info tekstiviites: lk 65 -->
  <macro name="loc-intext">
    <group delimiter=", ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>

  <!-- Raamatu väljaandekoht ja kirjastus -->
  <macro name="place-publisher">
    <group delimiter=", ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <!-- Artikli allikas: ajakiri, number, leheküljed -->
  <macro name="journal-container">
    <group delimiter=", ">
      <text variable="container-title" font-style="italic"/>
      <group delimiter=" ">
        <text term="number" form="short"/>
        <text variable="issue"/>
        <group prefix="(" suffix=")">
          <text variable="volume"/>
        </group>
      </group>
      <group delimiter=" ">
        <text term="page" form="short"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>

  <!-- Veebiallikas -->
  <macro name="web-container">
    <group delimiter=" ">
      <text value="Loetud aadressil:"/>
      <text variable="URL"/>
    </group>
  </macro>

  <!-- Raamatu kirje -->
  <macro name="book-bib">
    <group delimiter=" ">
      <text macro="author-bib"/>
      <group delimiter="">
        <text value="("/>
        <text macro="year"/>
        <text value=")."/>
      </group>
      <text variable="title" font-style="italic" suffix="."/>
      <text macro="place-publisher" suffix="."/>
    </group>
  </macro>

  <!-- Artikli kirje -->
  <macro name="article-bib">
    <group delimiter=" ">
      <text macro="author-bib"/>
      <group delimiter="">
        <text value="("/>
        <text macro="year"/>
        <text value=")."/>
      </group>
      <text variable="title" font-style="italic" suffix="."/>
      <text macro="journal-container" suffix="."/>
    </group>
  </macro>

  <!-- Veebiallikate kirje -->
  <macro name="web-bib">
    <group delimiter=" ">
      <text macro="author-bib"/>
      <group delimiter="">
        <text value="("/>
        <text macro="year"/>
        <text value=")."/>
      </group>
      <text variable="title" font-style="italic" suffix="."/>
      <text macro="web-container" suffix=""/>
      <group prefix=" [" suffix="]">
        <text value="Kasutatud "/>
        <date variable="accessed">
          <date-part name="day" form="numeric-leading-zeros"/>
          <date-part name="month" form="numeric-leading-zeros" prefix="."/>
          <date-part name="year" prefix="."/>
        </date>
      </group>
    </group>
  </macro>

  <!-- Vaikimisi kirje -->
  <macro name="default-bib">
    <group delimiter=" ">
      <text macro="author-bib"/>
      <group delimiter="">
        <text value="("/>
        <text macro="year"/>
        <text value=")."/>
      </group>
      <text variable="title" suffix="."/>
      <text variable="container-title" font-style="italic" suffix="."/>
    </group>
  </macro>

  <!-- Tekstisisene viide: (Meri, 1995, lk 65) -->
  <citation collapse="year" et-al-min="3" et-al-use-first="1">
    <sort>
      <key macro="author-intext"/>
      <key macro="year"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-intext"/>
        <text macro="year"/>
        <text macro="loc-intext"/>
      </group>
    </layout>
  </citation>

  <!-- Kasutatud allikate loetelu -->
  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="2">
    <sort>
      <key macro="author-bib"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>
    <layout>
      <choose>
        <if type="book">
          <text macro="book-bib"/>
        </if>
        <else-if type="article-journal article-magazine article-newspaper">
          <text macro="article-bib"/>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <text macro="web-bib"/>
        </else-if>
        <else>
          <text macro="default-bib"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>